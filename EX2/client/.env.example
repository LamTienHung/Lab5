# Copy thành .env (KHÔNG commit .env)
#   Copy-Item .env.example .env
# Chỉ biến có tiền tố VITE_ mới được Vite đưa vào code client.
# Tuyệt đối KHÔNG đặt PUSHER_SECRET hay service account ở đây.

# Pusher (public) — dashboard.pusher.com → lab5-chat → App Keys
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1

# Firebase Web config — Firebase console → ⚙ Project settings → General → Your apps → lab5-client
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=