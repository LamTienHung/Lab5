# Copy thành .env (KHÔNG commit .env)
#   Copy-Item .env.example .env

PORT=4001
CLIENT_ORIGIN=http://localhost:5173

# MongoDB replica set (bắt buộc cho Change Streams)
MONGODB_URI=mongodb://127.0.0.1:27017/lab5_chat?replicaSet=rs0

# Pusher — dashboard.pusher.com → app lab5-chat → App Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# Firebase Admin — đường dẫn tới file service account .json (đặt trong EX2/server)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json