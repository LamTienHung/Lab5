# Copy file này thành .env (KHÔNG commit .env)
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# Cổng server Express
PORT=4000

# MongoDB local — dùng 127.0.0.1 thay vì localhost
MONGODB_URI=mongodb://127.0.0.1:27017/lab5_reels

# Origin của Vite client (EX1/client) cho CORS
CLIENT_ORIGIN=http://localhost:5173